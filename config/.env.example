# Скопируйте в config/.env и заполните (scripts/setup.sh делает копию сам).
# config/.env не попадает в git. Значения НЕ попадают в переменные окружения системы —
# приложение читает этот файл само.

# --- Почта (пароли ПРИЛОЖЕНИЙ, не обычные пароли) ---
# Gmail: myaccount.google.com → Безопасность → Двухэтапная аутентификация → Пароли приложений.
#        Также включите IMAP: Gmail → Настройки → Пересылка и POP/IMAP.
GMAIL_LOGIN=
GMAIL_APP_PASSWORD=
# Яндекс: id.yandex.ru → Безопасность → Пароли приложений → Почта.
#        Включите IMAP: Почта → Настройки → Почтовые программы.
YANDEX_LOGIN=
YANDEX_APP_PASSWORD=

# --- Платные API (нужны только если в config/llm.yaml provider = anthropic_api или openai_api) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Описания вакансий LinkedIn через Google for Jobs (config/mail.yaml → linkedin_descriptions) ---
# JSearch: app.openwebninja.com → API Keys (бесплатный план). SerpApi: serpapi.com → Your Private API Key.
JSEARCH_API_KEY=
SERPAPI_API_KEY=

# --- Google Drive для отклика (config/apply.yaml → drive, docs/APPLY.md): OAuth-клиент «Desktop app» из Google Cloud.
#     После заполнения: .venv/bin/vacancy-retriever drive-login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Маскировка образцов писем (export-email-samples): имена / фамилия / телефон через запятую,
#     во всех написаниях, которые встречаются в письмах. Логины почты маскируются сами.
SAMPLE_MASK_WORDS=
